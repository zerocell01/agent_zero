# ===== Telegram =====
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=isi_token_bot_kamu

# ===== Backend LLM (gratis) =====
# Yang penting LLM-nya GRATIS. Bot ini butuh function calling yang andal
# (untuk mencatat transaksi/budget), jadi model yang kuat di tool-use lebih disukai.
# Lihat langkah lengkap di PANDUAN.md.

# --- AKTIF: pakai 9Router yang SUDAH jalan di VPS-mu ---
# Karena kamu sudah menjalankan 9Router (untuk bot lain), tinggal pakai ulang.
# Salin API key dari dashboard 9Router (http://localhost:20128).
# Model gratis & andal untuk function calling: Claude Sonnet via provider Kiro.
# Cek nama model persisnya di http://localhost:20128/v1/models
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=tempel_api_key_dari_dashboard_9router
LLM_MODEL=kr/claude-sonnet-4.5

# --- Alternatif: tetap pakai Hermes (gratis) via 9Router + OpenRouter ---
# Sambungkan provider OpenRouter di dashboard 9Router, lalu:
# LLM_MODEL=or/nousresearch/deephermes-3-llama-3-8b-preview:free
#   (catatan: model 8B gratis kadang kurang stabil untuk mencatat transaksi)

# --- Alternatif: OpenRouter LANGSUNG, tanpa 9Router (juga gratis) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# LLM_MODEL=nousresearch/deephermes-3-llama-3-8b-preview:free

# --- Alternatif: Ollama lokal di VPS (gratis, jalan di RAM 12GB) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=hermes3:8b

# ===== Lainnya =====
DB_PATH=finance.db
TIMEZONE=Asia/Jakarta
# Batasi akses bot ke ID Telegram tertentu (pisahkan dengan koma). Kosongkan = semua boleh.
ALLOWED_USER_IDS=
